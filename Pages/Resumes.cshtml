@page
@model ResumesModel

<div class="resumes-page">
    <div class="resumes-heading">
        <div>
            <p class="home-label">
                CollageJob
            </p>
            <h2>Каталог резюме</h2>
            <p>Знакомься со специалистами</p>
        </div>
        <a class="home-button" asp-page="/CreateResume">Создать резюме</a>
    </div>
    <p class="resumes-count">
        Всего резюме: @Model.Students.Count
    </p>

    @if (Model.Students.Count == 0)
    {
        <div class="resume-empty">
            <h2>Пока нет резюме: (╥﹏╥)</h2>
            <p>Стань первым - заполни свою анкету</p>
            <a asp-page="/CreateResume">Создать первое резюме</a>
        </div>
    }
    else
    {
        <div class="resume-grid">
            @foreach (var student in Model.Students)
            {
                <article class="resume-card">
                    <p class="resume-speciality">
                        @student.Speciality
                    </p>
                    <h2>@student.First_Name @student.Middle_Name</h2>
                    <p>@student.Last_Name</p>
                    <div class="resume-details">
                        <p>
                            <strong>Email:</strong>
                            @student.Email
                        </p>
                        <p>
                            <strong>Телефон:</strong>
                            @student.Phone
                        </p>
                        <p>
                            <strong>Технологии:</strong>
                            @(student.Technologies != null && student.Technologies.Count > 0
                                ? string.Join(", ", student.Technologies)
                                : "Не указаны")
                        </p>
                    </div>
                </article>
            }
        </div>
    }
</div>